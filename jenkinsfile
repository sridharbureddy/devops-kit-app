pipeline {
    agent any
    environment {
        registry = '959711113356.dkr.ecr.ap-south-1.amazonaws.com/matmari'
        region = 'ap-south-1'
    }

    stages {
        stage('Cloning Git') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: '*/test']],
                    userRemoteConfigs: [[
                        credentialsId: 'sridharbureddy',
                        url: 'https://github.com/sridharbureddy/devops-kit-app.git'
                    ]]
                ])
            }
        }

        stage('Setup AWS Credentials') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'sridharbureddy'
                ]]) {
                    script {
                        env.AWS_ACCESS_KEY_ID = "${env.AWS_ACCESS_KEY_ID}"
                        env.AWS_SECRET_ACCESS_KEY = "${env.AWS_SECRET_ACCESS_KEY}"
                    }

                    sh '''
                        echo "✅ AWS credentials loaded"
                        aws sts get-caller-identity --region $region
                    '''
                }
            }
        }

        stage('Building Docker Image') {
            steps {
                sh 'docker build -t devops-kit-app .'
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    echo "🔐 Logging in to AWS ECR01..."
                    aws ecr get-login-password --region $region | docker login --username AWS --password-stdin $registry
                    echo "📤 Pushing Docker image to ECR..."
                    docker tag devops-kit-app:latest $registry:latest
                    docker push $registry:latest
                '''
            }
        }
    }
}
